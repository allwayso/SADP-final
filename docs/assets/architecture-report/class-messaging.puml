@startuml
!include common.puml
skinparam defaultFontSize 17
top to bottom direction
class NotificationPublisher {
  +publish()
  +retryPending()
}
interface NotificationTransport {
  +send()
}
class RabbitNotificationTransport {
  +send()
}
class InProcessNotificationTransport {
  +send()
}
