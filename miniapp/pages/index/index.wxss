.page { padding: 48rpx; line-height: 1.7; }
.brand { font-size: 52rpx; font-weight: 700; letter-spacing: 2rpx; }
.accent { color: #d56f48; }
.subtitle { margin-top: 8rpx; color: #6d7f7b; font-size: 26rpx; }
.card { margin-top: 40rpx; padding: 32rpx; border: 1rpx solid #dfe9e3; border-radius: 16rpx; background: #fff; }
.who { font-size: 40rpx; font-weight: 700; }
.meta { color: #52665f; font-size: 28rpx; margin-top: 6rpx; }
.lead { font-size: 32rpx; font-weight: 600; margin-bottom: 12rpx; }
.hint { color: #71817d; font-size: 26rpx; margin: 12rpx 0; }
.label { margin-top: 24rpx; font-size: 26rpx; color: #52665f; }
input { margin-top: 8rpx; padding: 22rpx; border: 1rpx solid #c9d9d2; border-radius: 12rpx; font-size: 30rpx; }
button { margin-top: 32rpx; }
.secondary { background: #eff7f3; color: #176d5b; border: 1rpx solid #91b6aa; }
.message { margin-top: 28rpx; color: #a63f2c; font-size: 28rpx; }
