<view class="page">
  <view class="brand">check<text class="accent">@</text>collect</view>
  <view class="subtitle">POI 采集与核验 · 微信登录</view>

  <view wx:if="{{user}}" class="card">
    <view class="who">{{user.displayName}}</view>
    <view class="meta">账号 {{user.username}}</view>
    <view class="meta">用户 ID {{user.id}}</view>
    <view class="meta">角色 {{user.roles}}</view>
    <view class="meta">微信已绑定：{{user.wechatBound ? '是' : '否'}}</view>
    <view wx:if="{{step === 'pairing'}}">
      <view class="label">网页配对码</view>
      <input type="number" maxlength="8" value="{{pairingCode}}" bindinput="onPairingCode" placeholder="输入网页显示的 8 位配对码" />
      <button type="primary" bindtap="confirmPairing" disabled="{{busy}}" loading="{{busy}}">确认登录网站</button>
      <button class="secondary" bindtap="closePairing" disabled="{{busy}}">取消</button>
    </view>
    <button wx:else type="primary" bindtap="openPairing" disabled="{{busy}}">登录网站</button>
    <button class="secondary" bindtap="logout" disabled="{{busy}}" loading="{{busy}}">退出登录</button>
  </view>

  <view wx:elif="{{step === 'idle'}}" class="card">
    <view class="lead">用微信身份登录 check@collect。</view>
    <view class="hint">采集、核验与消息仍在网站上完成；小程序负责微信登录与绑定。</view>
    <button type="primary" bindtap="login" loading="{{busy}}" disabled="{{busy}}">微信一键登录</button>
  </view>

  <view wx:elif="{{step === 'choice'}}" class="card">
    <view class="lead">{{message || '该微信还没有绑定账号。'}}</view>
    <button type="primary" bindtap="chooseBind">用已有账号绑定微信</button>
    <button class="secondary" bindtap="chooseRegister">注册采集者账号</button>
    <view class="hint">核验者、第三方工作人员与管理员账号只能由管理员分配，不能在注册时自选。</view>
  </view>

  <view wx:elif="{{step === 'form'}}" class="card">
    <view class="lead">{{action === 'bind' ? '用已有账号绑定微信' : '注册采集者账号'}}</view>
    <view class="label">账号名</view>
    <input type="text" maxlength="64" value="{{username}}" bindinput="onUsername" placeholder="3-64 位字母、数字或 . _ -" />
    <block wx:if="{{action === 'register'}}">
      <view class="label">显示姓名</view>
      <input type="text" maxlength="100" value="{{displayName}}" bindinput="onName" placeholder="留空则使用账号名" />
    </block>
    <view class="label">密码</view>
    <input type="text" password="{{true}}" maxlength="128" value="{{password}}" bindinput="onPassword" placeholder="至少 10 位" />
    <button type="primary" bindtap="submit" loading="{{busy}}" disabled="{{busy}}">{{action === 'bind' ? '绑定并登录' : '注册并登录'}}</button>
    <button class="secondary" bindtap="back" disabled="{{busy}}">返回</button>
  </view>

  <view wx:if="{{message}}" class="message">{{message}}</view>
</view>
